# Database Configuration
DATABASE_URL=postgresql://admin:secure_password_change_in_production@localhost:5432/cryptopulse

# Redis Configuration
REDIS_URL=redis://:secure_redis_password@localhost:6379

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
FRONTEND_URL=http://localhost:3000

# Binance WebSocket (no credentials needed for public data)
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
